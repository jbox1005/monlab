{
  "version": "1.0",
  "_comment": "목적 뱃지 자동 부여 규칙. 위에서부터 평가하며 조건을 만족하면 뱃지를 부여합니다. 한 가게가 여러 뱃지를 가질 수 있습니다(예: 점심+회식).",
  "purpose_badges": [
    {
      "code": "LUNCH",
      "name": "점심식사",
      "desc": "평일 점심에 갈 수 있는 곳. 가격은 뱃지가 아니라 price_range 필터로 거른다(뱃지에 가격을 섞으면 규칙이 쉽게 깨짐).",
      "auto_rule": {
        "all": [
          {
            "field": "hours.lunch_open",
            "op": "eq",
            "value": true
          },
          {
            "field": "categories_l1",
            "op": "not_in",
            "value": [
              "CAF"
            ]
          },
          {
            "field": "biz.license_type",
            "op": "ne",
            "value": "유흥주점영업"
          }
        ]
      }
    },
    {
      "code": "CAFE",
      "name": "식후 카페",
      "desc": "밥 먹고 커피 한 잔. 카페/디저트 카테고리를 실제로 보유해야 한다(휴게음식점 인허가만으로는 분식집까지 딸려온다).",
      "auto_rule": {
        "any": [
          {
            "field": "categories_l1",
            "op": "contains",
            "value": "CAF"
          }
        ]
      }
    },
    {
      "code": "DINNER",
      "name": "회식장소",
      "desc": "술을 팔고 단체가 앉을 수 있는 곳.",
      "auto_rule": {
        "all": [
          {
            "field": "facility.serves_alcohol",
            "op": "eq",
            "value": true
          },
          {
            "any": [
              {
                "field": "facility.private_room",
                "op": "eq",
                "value": "YES"
              },
              {
                "field": "facility.group_capacity_max",
                "op": "gte",
                "value": 8
              },
              {
                "field": "vibe.tags",
                "op": "contains",
                "value": "단체석"
              }
            ]
          }
        ]
      }
    }
  ],
  "alcohol_inference": {
    "_comment": "주류판매 여부 1차 추정. 인허가 종별과 업태로 판단하며, BAR_* 카테고리는 무조건 true.",
