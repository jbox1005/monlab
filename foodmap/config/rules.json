  "field_tiers": {
    "_comment": "각 필드를 어떻게 채우는지. AUTO=수집으로 채워짐, SEMI=리뷰/텍스트 추출 필요, MANUAL=사람이 입력해야 함.",
    "AUTO": [
      "name",
      "address",
      "coord",
      "phone",
      "biz",
      "zone",
      "status",
      "distance.ibk_hq",
      "distance.ibk_finance_tower",
      "categories",
